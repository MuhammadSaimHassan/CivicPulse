# Copy to .env (gitignored) and change the passwords:  cp .env.example .env
# Nothing in this file is a real credential.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=civicpulse
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=change-me-postgres

# --- Redis ---------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis

# --- AI triage -----------------------------------------------------------------
# rules | llm | ollama | simulated
#   rules  works offline with no key (the default, so a fresh clone just runs)
#   llm    needs LLM_API_KEY. Groq: https://console.groq.com  (free, no card)
#   ollama run with:  docker compose --profile ollama up -d
TRIAGE_PROVIDER=rules
LLM_VENDOR=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=
# Gemini alternative (OpenAI-compatible endpoint):
#   LLM_VENDOR=gemini
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.5-flash-lite
OLLAMA_MODEL=llama3.2:1b

# --- Rate limiting (POST /api/complaints, per client IP) -------------------------
RATE_LIMIT_PER_WINDOW=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- Misc ------------------------------------------------------------------------
LOG_LEVEL=INFO
FRONTEND_PORT=8080
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- compose.prod.yaml only ---------------------------------------------------------
# GitHub user/org that owns the GHCR images (lowercase), and the commit SHA to run.
GHCR_OWNER=your-github-username
# IMAGE_TAG=<full commit sha>
